generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id       String    @id @default(uuid()) @db.Uuid
  code     String    @unique @db.VarChar(32)
  profiles Profile[]
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(254)
  passwordHash        String?              @db.VarChar(255)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  profile             Profile?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  tasksCreated        Task[]               @relation("TaskCreator")
  tasksAssigned       Task[]               @relation("TaskAssignee")
}

model TaskStatus {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(32)
  tasks Task[]
}

model TaskPriority {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(32)
  tasks Task[]
}

model Task {
  id               String       @id @default(uuid()) @db.Uuid
  title            String       @db.VarChar(120)
  description      String?      @db.Text
  statusId         String       @db.Uuid
  priorityId       String       @db.Uuid
  rewardPoints     Int          @default(0)
  estimateMinutes  Int?
  requiresApproval Boolean      @default(false)
  assigneeId       String       @db.Uuid
  createdById      String       @db.Uuid
  dueAt            DateTime?    @db.Timestamptz(3)
  reminderAt       DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  status           TaskStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  priority         TaskPriority @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  assignee         User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator          User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assigneeId, statusId, dueAt])
  @@index([createdById])
}

model Profile {
  userId      String @id @db.Uuid
  roleId      String @db.Uuid
  displayName String @db.VarChar(80)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
